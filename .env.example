# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ─── Database (Supabase / Postgres) ───────────────────────────────────────────
# Transaction pooler — used by Prisma ORM at runtime (port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Session pooler — used by Prisma Migrate (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── NextAuth (Auth.js v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_ME"
# Public URL of this app (used by NextAuth to build OAuth callback URLs)
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="REPLACE_ME"
GOOGLE_CLIENT_SECRET="REPLACE_ME"

# ─── App URL (used to build verification + reset links in emails) ─────────────
# Must be the externally-reachable origin. No trailing slash.
APP_URL="http://localhost:3000"

# ─── Brevo SMTP (transactional email) ─────────────────────────────────────────
# Dashboard: https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="REPLACE_ME"
BREVO_SMTP_PASS="REPLACE_ME"
BREVO_FROM_EMAIL="no-reply@your-domain.com"
BREVO_FROM_NAME="SplitEasy"
